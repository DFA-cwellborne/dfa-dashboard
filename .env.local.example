# Copy to .env.local and fill in. Never commit the real file.

# --- Supabase (the synced cache layer the dashboard reads from) ------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, used by the sync orchestrator to write data.
# Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets (the "Home" tab: totals, status/RSO breakdowns, roster) -
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Home
# Auth option A — service account (works on private sheets):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Auth option B — plain API key (only works if the sheet is set to "Anyone
# with the link can view"):
GOOGLE_SHEETS_API_KEY=

# --- Airtable ----------------------------------------------------------------
AIRTABLE_API_KEY=
# "Start a chapter" intake signups (its own base)
AIRTABLE_SIGNUPS_BASE_ID=
AIRTABLE_SIGNUPS_TABLE=
# Events hosted by chapters (a separate base)
AIRTABLE_EVENTS_BASE_ID=
AIRTABLE_EVENTS_TABLE=

# --- Breakthru (People API only — no chapters endpoint exists) -------------
BREAKTHRU_API_BASE_URL=
BREAKTHRU_API_KEY=

# --- Sync behavior -----------------------------------------------------------
# Minutes between scheduled syncs (start with 15-30).
SYNC_INTERVAL_MINUTES=20
# Shared secret the cron/scheduler must send as `Authorization: Bearer <secret>`
# when hitting /api/cron/sync.
SYNC_CRON_SECRET=change-me
# Set to "true" to run the dashboard entirely off generated mock data before
# any real credentials are wired up.
USE_MOCK_DATA=true
